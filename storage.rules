rules_version = '2';

// ============================================================================
// Règles de sécurité Storage — Quiz d'Eley
//  - LECTURE : publique (les images des questions s'affichent pour tous).
//  - ÉCRITURE : ADMIN uniquement (upload des images depuis la régie).
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'tzwjCg8m42ZZaWTmvQDzXZi9E7q1';
    }
  }
}
